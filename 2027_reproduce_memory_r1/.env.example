# Copy to `.env` and edit. All scripts pick these up when you `source .env` before running.

# HuggingFace: download models into ./models/ (sibling of ./data/) instead of the global cache.
HF_HOME=./models
TRANSFORMERS_CACHE=./models
HF_HUB_CACHE=./models

# Force a specific device (auto-detects otherwise: cuda > mps > cpu).
# MEMORY_R1_DEVICE=mps

# API keys for GPT-4o-mini (fact extraction + LLM-as-a-Judge).
# OPENAI_API_KEY=sk-...
# HUGGINGFACE_HUB_TOKEN=hf_...
